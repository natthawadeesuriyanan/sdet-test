# Copy to .env (git-ignored) and put your real token here.
# Get one at https://gorest.co.in/my-account/access-tokens
GOREST_API_TOKEN=your_token_here

# Optional overrides
# GOREST_BASE_URL=https://gorest.co.in/public/v2
# GOREST_MAX_RETRIES=4
# GOREST_MAX_RESPONSE_TIME_MS=10000
# GOREST_LOG_ALL=false
